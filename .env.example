# Veriplane stores local state here. The demo defaults to .veriplane/demo.db.
VERIPLANE_DB_PATH=.veriplane/veriplane.db
VERIPLANE_HOST=127.0.0.1
VERIPLANE_PORT=4317

# Optional provider keys. Without these, the deterministic demo provider works.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional connector credentials.
GITHUB_TOKEN=
NOTION_TOKEN=
GOOGLE_DRIVE_CREDENTIALS_JSON=

# Optional shared secret for POST /api/events. Keep unset for local-only demos.
VERIPLANE_INGEST_TOKEN=
